{
  "manifest_version": 3,
  "name": "ShortsOff - YouTube Shorts Blocker",
  "version": "0.1.0",
  "description": "Oculta los Shorts de YouTube sin peticiones de red.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
